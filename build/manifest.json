{
  "short_name": "WebBot",
  "author": "GESIS – Leibniz Institute for the Social Sciences",
  "name": "WebBot",
  "description": "WebBot",
  "manifest_version": 3,
  "version": "5.0.0",
  "permissions": ["tabs", "browsingData", "downloads", "storage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "128": "images/bot.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/bot.png",
        "data/*.txt"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "action": {},
  "options_ui": {
    "page": "index.html"
  },

  "background": {
    "service_worker": "dist/background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
